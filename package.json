{
  "name": "arcadeer",
  "version": "0.8.4",
  "description": "ローカル環境で動作するWebゲーム作成IDE",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wasm-pack build --target web --out-dir web/pkg",
    "build:release": "wasm-pack build --release --target web --out-dir web/pkg",
    "dev": "bun run build && bun run serve",
    "serve": "bun run serve.ts",
    "test": "bun test",
    "test:rust": "cargo test --lib"
  }
}
